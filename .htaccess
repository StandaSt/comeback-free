# .htaccess * Root Comeback

RewriteEngine On
DirectoryIndex index.php

# Produkce musi bezet pres HTTPS kvuli Service Workeru a Web Push.
# Localhost zustava bez presmerovani kvuli lokalnimu XAMPP vyvoji.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Bezpecnostni hlavicky.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Blokace citlivych souboru.
<FilesMatch "^(phpinfo\.php|info\.php|adminer\.php|debug\.log|dump\.sql|backup\.sql|database\.sql|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Blokace citlivych spolecnych casti.
RewriteRule ^common/(config|db)/ - [F,L]

# Stary modul is uz neexistuje. Cokoliv pod /is posli na korenovy vstup.
RewriteCond %{REQUEST_URI} ^(.*/)is(?:/.*)?$ [NC]
RewriteRule ^is(?:/.*)?$ %1index.php [R=301,L,NE]

# Moduly nemaji vlastni vstup. Prime otevreni posli na korenovy index.
RewriteCond %{REQUEST_URI} ^(.*/)(?:provoz|hr|smeny|ukoly|helpdesk)/?$ [NC]
RewriteRule ^(?:provoz|hr|smeny|ukoly|helpdesk)/?$ %1index.php [R=301,L,NE]

RewriteCond %{REQUEST_URI} ^(.*/)(?:provoz/provoz|hr/hr|smeny/smeny|ukoly/ukoly|helpdesk/helpdesk)\.php$ [NC]
RewriteRule ^(?:provoz/provoz|hr/hr|smeny/smeny|ukoly/ukoly|helpdesk/helpdesk)\.php$ %1index.php [R=301,L,NE]

# Nezasahovat do existujicich souboru a adresaru.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Root obslouzi spolecny login.
RewriteRule ^$ index.php [L,QSA]

# .htaccess * Root Comeback
# Konec souboru
